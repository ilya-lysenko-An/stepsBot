# Скопировать в token.env и заполнить. В git этот файл не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Ссылка на перевод взноса (Т-Банк и т.п.)
URL=

# telegram_id организаторов через запятую. Узнать свой: отправить боту /myid
ADMIN_IDS=

# Необязательно: отдельная ссылка на оплату, если не хотите использовать URL
PAYMENT_URL=

# Кому присылать чеки
PAYMENT_CONTACT=@Ds2dle

# 0 — участвуют все, кто нажал «УЧАСТВУЮ» (текущий режим)
# 1 — строгое правило ТЗ: без отметки оплаты нет допуска к месяцу и розыгрышу
REQUIRE_PAYMENT=0
