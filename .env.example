# Скопировать в token.env и заполнить. В git этот файл не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Ссылки на сборы. Показываются в /register и в ответе на шаги в даты из
# PAYMENT_PROMPT_DATES. Т-Банк исторически лежит в ключе URL.
URL=
SBER_URL=

# telegram_id организаторов через запятую. Узнать свой: отправить боту /myid
ADMIN_IDS=

# Даты, в которые к ответу на шаги приклеивается блок со сборами (через запятую).
# По умолчанию 2026-09-30.
PAYMENT_PROMPT_DATES=

# Кому присылать чеки
PAYMENT_CONTACT=@Ds2dle
